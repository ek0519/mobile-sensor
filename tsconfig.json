{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "bun",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@mobile-sensor/core": [
        "packages/core/src/index.ts"
      ],
      "@mobile-sensor/react": [
        "packages/react/src/index.ts"
      ],
      "@mobile-sensor/vue": [
        "packages/vue/src/index.ts"
      ],
      "@mobile-sensor/svelte": [
        "packages/svelte/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
