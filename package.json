{
  "name": "mobile-sensors-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --workspace apps/demo --tsconfig tsconfig.json --config vite.config.ts",
    "build": "bun run scripts/build.ts && vite build --config apps/demo/vite.config.ts",
    "dev": "vite --config apps/demo/vite.config.ts --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:pack": "bun run scripts/pack-smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vite": "^7.3.6",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vue": "^3.5.21",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/svelte": "^5.2.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.0",
    "@types/bun": "latest",
    "esbuild": "^0.25.10"
  }
}
